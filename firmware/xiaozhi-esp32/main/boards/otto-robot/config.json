{
    "type": "otto-robot",
    "target": "esp32s3",
    "builds": [
        {
            "name": "otto-robot",
            "build_options": {
                "camera_hmirror": true,
                "camera_vflip": true,
                "multiline_chat": true
            },
            "sdkconfig_append": [
                "CONFIG_OTA_URL=\"https://xrobo.qiniuapi.com/v1/ota/\"",
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_CAMERA_OV2640=y",
                "CONFIG_CAMERA_OV3660=y"
            ]
        }
    ]
}
